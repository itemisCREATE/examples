/* Defines which code generator to use */ 
GeneratorModel for create::sctunit::csharp {
	/* Refers to the sctunit test 'LightSwitchTest' */
	test LightSwitchTest {
		/* Specify the target location for the generated artifacts. */
		feature Outlet {
			targetProject = "itemis.create.examples.sctunit.csharp"
			targetFolder = "src-gen"
		}
		/* The namespace of the generated test fixture. */
		feature Naming {
			baseNamespace = "Itemis.Create.Examples.Sctunit.Csharp.Tests"
		}
		/* The namespace of the state machine under test - it is generated by the other generator
		   model, so this one has to be told where it ends up. */
		feature StatechartNaming {
			baseNamespace = "Itemis.Create.Examples.Sctunit.Csharp"
		}
	}
}
