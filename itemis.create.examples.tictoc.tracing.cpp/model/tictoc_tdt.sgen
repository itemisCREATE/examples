/* Generates the TDT tracer; its options have to match those of the state machine. */
GeneratorModel for create::cpp::tdt {

	statechart tictoc {

		feature Outlet {
			targetProject = "itemis.create.examples.tictoc.tracing.cpp"
			targetFolder = "src-gen"
		}

		feature Tracing {
			generic = true
		}

		feature GeneralFeatures {
			timerService = true
		}
	}
}
